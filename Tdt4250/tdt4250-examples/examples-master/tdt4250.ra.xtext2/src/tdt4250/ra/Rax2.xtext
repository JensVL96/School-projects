// automatically generated by Xtext
grammar tdt4250.ra.Rax2 with org.eclipse.xtext.common.Terminals

import "platform:/plugin/tdt4250.ra/model/ra.ecore" 
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Department:
	shortName = ID '-' name = STRING
	'Persons:'
		(staff += Person)*
	'Courses:'
		(courses += Course)*
	'Allocations:'
		(resourceAllocations += ResourceAllocation)*
;

NameOrString: (ID | STRING);

Person:
	name = NameOrString
;

Course:
	code = ID '-' name = NameOrString
	('requires' roles += Role (',' roles += Role)*)?
;

Role:
	name = ID 'for' workload = FactorAsPercentage
;

FactorAsPercentage returns ecore::EFloat : INT ('.' INT)? '%';

ResourceAllocation:
	person = [Person | NameOrString] 'is'
	(
		(factor = FactorAsPercentage 'in' course = [Course]) |
		('in' course = [Course] 'as' factor = FactorAsPercentage role = [Role])
	)
;
