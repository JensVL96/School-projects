# Run all integration tests which are named xyzTest
Test-Cases: ${classes;CONCRETE;PUBLIC;NAMED;*Test}

# A temporary inclusion until an R7 framework is available
Import-Package: org.osgi.framework.*;version="[1.8,2)",*

# Build dependencies 
-buildpath: \
	${junit},\
	${mockito},\
	${mockito-deps},\
	osgi.annotation; version=7.0.0,\
	osgi.core; version=7.0.0,\
	osgi.cmpn; version=7.0.0

javac.source: 1.8
javac.target: 1.8

# We need JUnit and Mockito to resolve the test cases at runtime. 
# Other runtime dependencies should be added as necessary
-runbundles: \
	net.bytebuddy.byte-buddy;version='[1.8.0,1.8.1)',\
	net.bytebuddy.byte-buddy-agent;version='[1.8.0,1.8.1)',\
	org.apache.felix.http.jetty;version='[4.0.6,4.0.7)',\
	org.apache.felix.http.servlet-api;version='[1.1.2,1.1.3)',\
	org.apache.felix.scr;version='[2.1.10,2.1.11)',\
	org.apache.servicemix.bundles.junit;version='[4.12.0,4.12.1)',\
	org.mockito.mockito-core;version='[2.17.0,2.17.1)',\
	org.objenesis;version='[2.6.0,2.6.1)',\
	tdt4250.dict1.servlet;version=snapshot,\
	tdt4250.dict1.servlet.test;version=snapshot

Bundle-Version: 0.0.0.${tstamp}

# Needed for Mockito's mocking to work
-runsystempackages.objenesis: sun.misc,sun.reflect

# Use Equinox by default
-runfw: org.eclipse.osgi;version=3.13
-runvm: -ea
-runrequires: \
	bnd.identity;id='tdt4250.dict1.servlet',\
	bnd.identity;id='tdt4250.dict1.servlet.test'
-runee: JavaSE-1.8
-runproperties: org.osgi.service.http.port=8080