<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.3.0" name="org.bndtools.templating.extension" activate="activate" deactivate="dectivate">
  <property name="source" type="String" value="extension"/>
  <property name="service.description" type="String" value="Load templates from the Eclipse Extension Registry"/>
  <service>
    <provide interface="org.bndtools.templating.TemplateLoader"/>
  </service>
  <reference name="ExecutorService" cardinality="0..1" interface="java.util.concurrent.ExecutorService" bind="setExecutorService" policy-option="greedy"/>
  <implementation class="org.bndtools.core.templating.extreg.ExtensionRegistryTemplateLoader"/>
</scr:component>
